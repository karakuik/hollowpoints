# Supabase — Settings → API in your Supabase dashboard
# VITE_ prefix = exposed to browser (safe for anon key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# No VITE_ prefix = server-only (Netlify Functions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # NEVER expose this to the browser

# Steam — optional, for Now page live data
# Get API key: steamcommunity.com/dev/apikey
# Get Steam ID: steamidfinder.com
STEAM_API_KEY=
STEAM_USER_ID=
